# RBL Scan — configuração do backend
#
# Copie para .env e preencha:
#     cp .env.example .env
#
# O .env NÃO vai para o Git (veja .gitignore). Variáveis já exportadas no shell
# têm precedência sobre o que estiver aqui.


# ---------------------------------------------------------------------------
# Chave DQS da Spamhaus  —  https://portal.spamhaus.com/dqs/
# ---------------------------------------------------------------------------
# Sem ela a zona ZEN é pulada, e é justamente a lista mais relevante:
# é ela que separa SBL, CSS, XBL e PBL. Sem ZEN você não distingue
# "listado por falta de reverso" de "listado por spam saindo".
#
# Só a chave, sem o nome da zona. O código monta <chave>.zen.dq.spamhaus.net.
SPAMHAUS_DQS_KEY=


# ---------------------------------------------------------------------------
# Resolver recursivo
# ---------------------------------------------------------------------------
# IP de um recursivo SEU (unbound, bind, o DNS do NOC). Deixe vazio para usar
# o resolver do sistema.
#
# Não aponte para 8.8.8.8, 1.1.1.1 ou 9.9.9.9: as RBLs recusam consultas vindas
# de resolvers públicos e respondem NXDOMAIN. O scan não erra — ele reporta o
# bloco como limpo, que é bem pior.
RBLSCAN_RESOLVER=


# ---------------------------------------------------------------------------
# Limites e origens
# ---------------------------------------------------------------------------
# Teto de endereços por varredura. Um /24 no perfil core já são ~2.000
# consultas DNS. Subir muito daqui é caminho rápido para a lista bloquear o
# resolver do NOC — e aí você perde visibilidade em todos os clientes.
RBLSCAN_MAX=4096

# Origens liberadas no CORS, separadas por vírgula.
# Em produção, troque pelo domínio real onde o frontend for servido.
RBLSCAN_ORIGINS=http://localhost:5173


# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------
# Vazio mantém o repositório em memória, e o histórico morre ao reiniciar.
# Definir esta variável SEM implementar SqlRepository faz a aplicação falhar
# de propósito: dado que o operador pensa estar persistido e não está é pior
# que erro visível.
RBLSCAN_DATABASE_URL=

# Máximo de arquivos de configuração por análise.
RBLSCAN_MAX_FILES=10
